{
    "extends": "@chatie/tsconfig",
    "compilerOptions": {
      "ignoreDeprecations": "5.0",
      "esModuleInterop": true,
      "outDir": "dist"
    },
    "exclude": [
      "node_modules/",
      "dist/",
      "tests/fixtures/"
    ],
    "include": [
      "src/*/*.ts",
      "src/*.ts",
      "tests/*.ts",
      "tests/*/*.ts", "src/bot/handlers/poem-palette.ts", "src/bot/handlers/poem-palette-coze.ts", "src/bot/handlers/coze.ts",
    ],
  }
